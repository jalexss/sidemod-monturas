{
	"schemaVersion": 1,
	"id": "cobble_mounts",
	"version": "${version}",
	"name": "Cobblemon Custom Mounts",
	"description": "Sidemod of cobblemon to assign pokemons in PC for be used as mounts in the world",
	"authors": [
		"Soleysus"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/cobble_mounts/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.soleysus.cobblemounts.CobbleMounts"
		],
		"client": [
			"com.soleysus.cobblemounts.client.CobbleMountsClient"
		]
	},
	"mixins": [
		"cobble_mounts.mixins.json",
		{
			"config": "cobble_mounts.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.17.2",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": "*",
		"cobblemon": ">=1.7.3 <1.8.0"
	},
	"suggests": {
		"waystones": "*"
	},
	"custom": {
		"cobble_mounts": {
			"teleport_requires": "waystones",
			"teleport_species": ["abra", "kadabra", "alakazam", "ralts", "kirlia", "gardevoir", "gallade"]
		}
	}
}
